PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
ADMIN_KEY=change-this-to-a-secret-value

# Allowed frontend origin(s), comma-separated. Leave unset to allow any origin.
# CLIENT_URL=https://your-portfolio.vercel.app,http://localhost:5173

# Your Gmail address. It sends the contact form notifications.
EMAIL_USER=you@gmail.com
# A 16-letter Gmail App Password for the account above (NOT your normal Gmail password).
# Turn on 2-Step Verification, then generate one at https://myaccount.google.com/apppasswords
EMAIL_PASS=your-app-password
# Optional: where notifications are delivered. Defaults to EMAIL_USER.
# EMAIL_TO=you@gmail.com
