PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
ADMIN_KEY=change-this-to-a-secret-value

# Your Gmail address. It both sends and receives the contact form notifications.
EMAIL_USER=you@gmail.com
# A Gmail App Password for the account above (not your normal Gmail password).
# Generate one at https://myaccount.google.com/apppasswords
EMAIL_PASS=your-app-password
